# SentinelEye backend configuration. Copy to .env and fill in real values.
# Every variable is optional except SENTINELEYE_ADMIN_TOKEN, without which the
# management API and fleet dashboard stay disabled.

# Long random secret for the management API and dashboard sign-in.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINELEYE_ADMIN_TOKEN=change-me

# Let anyone view servers, history and alerts read-only without signing in, e.g. for a
# public showcase. Registering servers, tokens, settings and alert actions still need the
# admin token. Leave false for a private installation.
SENTINELEYE_PUBLIC_DASHBOARD=false

# SQLite by default. In Docker this points into the persistent /data volume.
SENTINELEYE_DATABASE_URL=sqlite:///./data/sentineleye.db

# A server is marked offline after this many seconds without a report (agents send every 30s)
SENTINELEYE_HEARTBEAT_TIMEOUT_SECONDS=90

# Alerting
SENTINELEYE_ALERT_CONSECUTIVE_BREACHES=2
SENTINELEYE_DEFAULT_CPU_THRESHOLD=80
SENTINELEYE_DEFAULT_MEMORY_THRESHOLD=85
SENTINELEYE_DEFAULT_DISK_THRESHOLD=80

# Metric history older than this is deleted hourly
SENTINELEYE_METRIC_RETENTION_DAYS=30

# Optional e-mail notifications. Leave SMTP_HOST empty to disable.
SENTINELEYE_SMTP_HOST=
SENTINELEYE_SMTP_PORT=587
SENTINELEYE_SMTP_USERNAME=
SENTINELEYE_SMTP_PASSWORD=
SENTINELEYE_SMTP_FROM=
SENTINELEYE_SMTP_TO=
SENTINELEYE_SMTP_STARTTLS=true

# Only needed if the dashboard is served from a different origin than the API
SENTINELEYE_CORS_ORIGINS=
