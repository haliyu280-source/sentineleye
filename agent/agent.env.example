# SentinelEye agent configuration
# Installed to /etc/sentineleye-agent/agent.env (owner root, group sentineleye, mode 640).

# Address of the central SentinelEye backend. Use https:// in production.
SENTINELEYE_URL=https://sentineleye.example.com

# Shown once when the server is registered (or when a token is reissued)
SENTINELEYE_SERVER_ID=1
SENTINELEYE_TOKEN=se_0000000000000000_replace-with-the-token-from-registration-xxxx

# Seconds between samples (5-3600)
SENTINELEYE_INTERVAL=30

# Optional
# SENTINELEYE_TIMEOUT=10            # per request, seconds
# SENTINELEYE_MAX_RETRIES=4         # retries per sample on network errors / 5xx / 429
# SENTINELEYE_DISK_PATH=/           # filesystem to report
# SENTINELEYE_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem   # private CA for the backend's certificate
# SENTINELEYE_ALLOW_HTTP=false      # only for isolated test networks; sends the token unencrypted
